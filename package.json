  "description": "A reusable React library that adds beautiful visual effects and user experience enhancements.",
  "type": "module",
  "main": "dist/react-tarxemo-effects.umd.cjs",
  "module": "dist/react-tarxemo-effects.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-tarxemo-effects.js",
